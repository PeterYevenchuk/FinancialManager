<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinancialManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinancialManager"
    xmlns:views="clr-namespace:FinancialManager.Views"
    xmlns:vm="clr-namespace:FinancialManager.ViewModels"
    xmlns:resources="clr-namespace:Resources"
    x:DataType="vm:AppShellViewModel"
    Title="FinancialManager">

    <FlyoutItem Title="{DynamicResource HomeTitle}" Icon="home_icon.png">
        <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{DynamicResource TransactionsTitle}" Icon="list_icon.png">
        <ShellContent ContentTemplate="{DataTemplate views:TransactionPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{DynamicResource CategoriesTitle}" Icon="category_icon.png">
        <ShellContent ContentTemplate="{DataTemplate views:CategoryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="{DynamicResource TransactionTypesTitle}" Icon="settings_icon.png">
        <ShellContent ContentTemplate="{DataTemplate views:TransactionTypePage}" />
    </FlyoutItem>

    <FlyoutItem Title="{DynamicResource BackupTitle}" Route="BackupPage">
        <FlyoutItem.Icon>
            <FontImageSource Glyph="🛡️" Size="20" Color="White"/>
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:BackupPage}" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Frame BackgroundColor="#1a1a1a" 
               BorderColor="#333" 
               CornerRadius="0" 
               Padding="15,10" 
               HasShadow="False"
               x:DataType="vm:AppShellViewModel">
            <VerticalStackLayout Spacing="5">
                <Label Text="{DynamicResource LanguageLabel}" 
                       TextColor="#888" 
                       FontSize="11" 
                       FontAttributes="Bold"/>

                <Picker ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.Languages}"
                        SelectedItem="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=BindingContext.SelectedLanguage, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding Name}"
                        TextColor="White"
                        TitleColor="#555"
                        FontSize="14"
                        HeightRequest="40"
                        BackgroundColor="#252525"/>
            </VerticalStackLayout>
        </Frame>
    </Shell.FlyoutFooter>
</Shell>