<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinancialManager.Views.CategoryAddPage"
             Title="Add New Category">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Category Icon (Emoji or Text)" />
        <Entry Text="{Binding Icon}" Placeholder="e.g. 🍕" />

        <Label Text="Name (English) *" FontAttributes="Bold" />
        <Entry Text="{Binding NameEng}" Placeholder="Required" />

        <Label Text="Назва (Українська)" />
        <Entry Text="{Binding NameUkr}" Placeholder="Optional" />

        <Button Text="Save Category" 
                Command="{Binding SaveCommand}"
                Margin="0,20,0,0" 
                BackgroundColor="#2196F3" 
                TextColor="White" />

    </VerticalStackLayout>
</ContentPage>