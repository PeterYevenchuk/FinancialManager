<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Resources"
             x:Class="FinancialManager.Views.CategoryAddPage"
             Title="{DynamicResource AddNewCategoryTitle}">

    <VerticalStackLayout Padding="20" Spacing="15">

        <VerticalStackLayout Spacing="5">
            <Label Text="{DynamicResource CategoryIconLabel}" TextColor="#aaa" />
            <Entry Text="{Binding Icon}" Placeholder="{DynamicResource PlaceholderIcon}" TextColor="White" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="{DynamicResource NameEnglishLabel}" FontAttributes="Bold" TextColor="White" />
            <Entry Text="{Binding NameEng}" Placeholder="{DynamicResource PlaceholderRequired}" TextColor="White" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsUkrVisible}">
            <Label Text="{DynamicResource NameUkrLabel}" TextColor="#aaa" />
            <Entry Text="{Binding NameUkr}" Placeholder="{DynamicResource PlaceholderOptional}" TextColor="White" />
        </VerticalStackLayout>

        <Button Text="{DynamicResource Save}" 
                Command="{Binding SaveCommand}"
                Margin="0,20,0,0" 
                BackgroundColor="#2196F3" 
                TextColor="White" />

    </VerticalStackLayout>
</ContentPage>