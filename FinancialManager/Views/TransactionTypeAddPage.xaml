<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             x:Class="FinancialManager.Views.TransactionTypeAddPage"
             Title="Manage Type"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Name (English) *" FontAttributes="Bold" />
        <Entry Text="{Binding NameEng}" Placeholder="Required" />

        <Label Text="Назва (Українська)" />
        <Entry Text="{Binding NameUkr}" Placeholder="Optional" />

        <Button Text="Save" 
         Command="{Binding SaveCommand}"
         Margin="0,20,0,0" 
         BackgroundColor="#2196F3" 
         TextColor="White" />

    </VerticalStackLayout>
</ContentPage>