<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             x:Class="FinancialManager.Views.TransactionTypeAddPage"
             Title="{DynamicResource ManageTypeTitle}"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="20" Spacing="15">

        <VerticalStackLayout Spacing="5">
            <Label Text="{DynamicResource TransactionType_IconLabel}" />
            <Entry Text="{Binding Icon}" Placeholder="{DynamicResource PlaceholderIcon}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5">
            <Label Text="{DynamicResource NameEnglishLabel}" FontAttributes="Bold" />
            <Entry Text="{Binding NameEng}" Placeholder="{DynamicResource PlaceholderRequired}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsUkrVisible}">
            <Label Text="{DynamicResource NameUkrLabel}" />
            <Entry Text="{Binding NameUkr}" Placeholder="{DynamicResource PlaceholderOptional}" />
        </VerticalStackLayout>

        <Button Text="{DynamicResource Save}" 
             Command="{Binding SaveCommand}"
             Margin="0,20,0,0" 
             BackgroundColor="#2196F3" 
             TextColor="White" />

    </VerticalStackLayout>
</ContentPage>