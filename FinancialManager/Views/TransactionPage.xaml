<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             xmlns:resources="clr-namespace:Resources"
             x:Class="FinancialManager.Views.TransactionPage"
             x:Name="thisPage"
             Title="{DynamicResource TransactionsTitle}"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" Margin="12,10" Padding="14" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{DynamicResource CategoryLabel}" TextColor="{StaticResource SubtleText}" FontSize="12"/>
                        <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                            <Picker ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategoryFilter}"
                                    ItemDisplayBinding="{Binding LocalizedName}"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource MutedText}"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{DynamicResource TypeLabel}" TextColor="{StaticResource SubtleText}" FontSize="12"/>
                        <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0">
                            <Picker ItemsSource="{Binding TransactionTypes}"
                                    SelectedItem="{Binding SelectedTypeFilter}"
                                    ItemDisplayBinding="{Binding LocalizedName}"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource MutedText}"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                        Text="{DynamicResource Apply}"
                        Command="{Binding ApplyFiltersCommand}"
                        BackgroundColor="{StaticResource AccentGreen}"
                        TextColor="{StaticResource OnAccentText}"
                        FontAttributes="Bold"
                        VerticalOptions="End"
                        HeightRequest="42"
                        WidthRequest="95"
                        CornerRadius="10"
                        Padding="0"/>
                </Grid>

                <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{DynamicResource FromLabel}" FontSize="14" TextColor="{StaticResource SubtleText}" VerticalOptions="Center"/>
                        <DatePicker Date="{Binding DateFrom}"
                                    MaximumDate="{Binding DateTo}"
                                    Format="dd.MM.yyyy"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{DynamicResource ToLabel}" FontSize="14" TextColor="{StaticResource SubtleText}" VerticalOptions="Center"/>
                        <DatePicker Date="{Binding DateTo}"
                                    MinimumDate="{Binding DateFrom}"
                                    Format="dd.MM.yyyy"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Button Grid.Column="2"
                            Text="{DynamicResource Reset}"
                            FontSize="12"
                            Command="{Binding ClearFiltersCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Accent}"
                            BorderColor="{StaticResource Accent}"
                            BorderWidth="1"
                            CornerRadius="8"
                            Padding="14,4"
                            MinimumHeightRequest="0"
                            HeightRequest="34"
                            VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Transactions}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <Grid Margin="12,5">

                        <Border Padding="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                            Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectTransactionCommand}"
                            CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout>
                                <Grid Padding="15" ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Spacing="4">

                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Category.Icon}" FontSize="18"/>
                                            <Label Text="{Binding Category.LocalizedName}" FontSize="16" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="10" Margin="28,0,0,0">
                                            <Label Text="{Binding TransactionType.Icon}" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="{Binding TransactionType.LocalizedName}" FontSize="14" TextColor="{StaticResource SubtleText}"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="{StaticResource MutedText}" Margin="28,0,0,0"/>

                                        <Label Text="{Binding Description}"
                                            FontSize="14"
                                            TextColor="{StaticResource SubtleText}"
                                            LineBreakMode="WordWrap"
                                            Margin="28,2,15,0"/>

                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         HorizontalOptions="End"
                                         Spacing="2">

                                        <Label Text="{Binding AmountDisplay}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           HorizontalOptions="End"/>

                                        <Label Text="{Binding ExchangeRateToUahDisplay}"
                                           FontSize="12"
                                           TextColor="{StaticResource MutedText}"
                                           IsVisible="{Binding ShowExchangeRate}"
                                           HorizontalOptions="End"/>

                                    </VerticalStackLayout>

                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource CardStroke}" IsVisible="{Binding IsSelected}"/>

                                <VerticalStackLayout IsVisible="{Binding IsSelected}" BackgroundColor="{StaticResource CardBackgroundAlt}" Padding="15,12">

                                    <Grid ColumnDefinitions="*, *">
                                        <Button Grid.Column="0" Text="{DynamicResource Edit}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent"
                                        Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="1" Text="{DynamicResource Delete}" TextColor="{StaticResource Danger}" BackgroundColor="Transparent"
                                        Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.DeleteTransactionCommand}" CommandParameter="{Binding .}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout HeightRequest="90"/>
            </CollectionView.Footer>
        </CollectionView>

        <Button Grid.Row="1" Text="{DynamicResource Plus}" FontSize="24" BackgroundColor="{StaticResource AccentGreen}" TextColor="{StaticResource OnAccentText}" CornerRadius="28"
                HeightRequest="56" WidthRequest="56" HorizontalOptions="End" VerticalOptions="End" Margin="20"
                Command="{Binding AddTransactionCommand}"/>
    </Grid>
</ContentPage>
