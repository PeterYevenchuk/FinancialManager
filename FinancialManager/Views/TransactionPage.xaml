<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             xmlns:resources="clr-namespace:Resources"
             x:Class="FinancialManager.Views.TransactionPage"
             x:Name="thisPage"
             Title="{DynamicResource TransactionsTitle}"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">

        <Frame Grid.Row="0" Margin="10" Padding="10" BackgroundColor="#1a1a1a" BorderColor="#333" CornerRadius="10">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{DynamicResource CategoryLabel}" TextColor="#aaa" FontSize="12"/>
                        <Picker ItemsSource="{Binding Categories}" 
                        SelectedItem="{Binding SelectedCategoryFilter}" 
                        ItemDisplayBinding="{Binding LocalizedName}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="{DynamicResource TypeLabel}" TextColor="#aaa" FontSize="12"/>
                        <Picker ItemsSource="{Binding TransactionTypes}" 
                        SelectedItem="{Binding SelectedTypeFilter}" 
                        ItemDisplayBinding="{Binding LocalizedName}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                        Text="{DynamicResource Apply}" 
                        Command="{Binding ApplyFiltersCommand}" 
                        BackgroundColor="#28a745" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        VerticalOptions="End" 
                        HeightRequest="36"
                        WidthRequest="95"
                        Padding="0"
                        Margin="0,0,0,1"/>
                </Grid>

                <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{DynamicResource FromLabel}" FontSize="14" TextColor="#aaa" VerticalOptions="Center"/>
                        <DatePicker Date="{Binding DateFrom}" 
                    MaximumDate="{Binding DateTo}" 
                    Format="dd.MM.yyyy" 
                    TextColor="White" 
                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{DynamicResource ToLabel}" FontSize="14" TextColor="#aaa" VerticalOptions="Center"/>
                        <DatePicker Date="{Binding DateTo}" 
                    MinimumDate="{Binding DateFrom}" 
                    Format="dd.MM.yyyy" 
                    TextColor="White" 
                    VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <Button Text="{DynamicResource ClearFilters}" Command="{Binding ClearFiltersCommand}" 
                        BackgroundColor="Transparent" TextColor="#2196F3" Padding="0" HeightRequest="30"/>
            </VerticalStackLayout>
        </Frame>

        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Transactions}" 
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <Grid Margin="10,5">

                        <Frame Padding="0" CornerRadius="10" HasShadow="False" BackgroundColor="#1a1a1a" BorderColor="#333" Margin="10,0,10,0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                            Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectTransactionCommand}" 
                            CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout>
                                <Grid Padding="15" ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Spacing="4">

                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Category.Icon}" FontSize="18"/>
                                            <Label Text="{Binding Category.LocalizedName}" FontSize="16" TextColor="White" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="10" Margin="28,0,0,0">
                                            <Label Text="{Binding TransactionType.Icon}" FontSize="14" VerticalOptions="Center"/>
                                            <Label Text="{Binding TransactionType.LocalizedName}" FontSize="14" TextColor="#bbb"/>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="#888" Margin="28,0,0,0"/>

  
                                        <Label Text="{Binding Description}" 
                                            FontSize="14" 
                                            TextColor="#bbb"
                                            LineBreakMode="WordWrap"
                                            Margin="28,2,15,0"/>

                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" 
                                       Text="{Binding AmountDisplay}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       VerticalOptions="Center"
                                       TextColor="White"/>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#333" IsVisible="{Binding IsSelected}"/>

                                <VerticalStackLayout IsVisible="{Binding IsSelected}" BackgroundColor="#252525" Padding="15,12">

                                    <Grid ColumnDefinitions="*, *">
                                        <Button Grid.Column="0" Text="{DynamicResource Edit}" TextColor="White" BackgroundColor="Transparent"
                                        Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="1" Text="{DynamicResource Delete}" TextColor="#ff4d4d" BackgroundColor="Transparent"
                                        Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.DeleteTransactionCommand}" CommandParameter="{Binding .}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="{DynamicResource Plus}" FontSize="24" BackgroundColor="#28a745" TextColor="White" CornerRadius="25"
                HeightRequest="50" WidthRequest="50" HorizontalOptions="End" VerticalOptions="End" Margin="20"
                Command="{Binding AddTransactionCommand}"/>
    </Grid>
</ContentPage>