<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             x:Class="FinancialManager.Views.TransactionTypePage"
             Title="Transaction Types">

    <Grid>
        <CollectionView ItemsSource="{Binding TransactionTypes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedType}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TransactionType">
                    <Grid Margin="10,5">
                        <Frame Padding="0" 
                               CornerRadius="10" 
                               HasShadow="False" 
                               BackgroundColor="#1a1a1a"
                               BorderColor="#333">

                            <VerticalStackLayout>
                                <Grid Padding="15">
                                    <Label Text="{Binding LocalizedName}" 
                                           FontSize="18" 
                                           VerticalOptions="Center" 
                                           TextColor="White"/>
                                </Grid>

                                <BoxView HeightRequest="1" 
                                         BackgroundColor="#333" 
                                         IsVisible="{Binding IsSelected}"/>

                                <Grid IsVisible="{Binding IsSelected}" 
                                      ColumnDefinitions="*, *" 
                                      HeightRequest="50"
                                      BackgroundColor="#252525">

                                    <Button Grid.Column="0" 
                                            Text="✏️ Edit" 
                                            TextColor="White"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionTypeViewModel}}, Path=EditTransactionTypeCommand}"
                                            CommandParameter="{Binding .}"/>

                                    <Button Grid.Column="1" 
                                            Text="🗑️ Delete" 
                                            TextColor="#ff4d4d"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionTypeViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="+"
                FontSize="24"
                BackgroundColor="#28a745"
                TextColor="White"
                CornerRadius="25"
                HeightRequest="50"
                WidthRequest="50"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Command="{Binding AddTransactionTypesCommand}"/>
    </Grid>
</ContentPage>