<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinancialManager.Views.TransactionAddPage"
             Title="Manage Transaction">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Amount *" FontAttributes="Bold" />
        <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0.00" />

        <Label Text="Description" />
        <Entry Text="{Binding Description}" Placeholder="e.g. Dinner, Gas" MaxLength="250" />

        <Label Text="Category *" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding Categories}" 
                SelectedItem="{Binding SelectedCategory}" 
                ItemDisplayBinding="{Binding LocalizedName}" 
                Title="Select Category" />

        <Label Text="Type *" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding TransactionTypes}" 
                SelectedItem="{Binding SelectedType}" 
                ItemDisplayBinding="{Binding LocalizedName}" 
                Title="Select Type" />

        <Label Text="Date" />
        <DatePicker Date="{Binding Date}" />

        <Button Text="Save" 
                Command="{Binding SaveCommand}"
                Margin="0,20,0,0" 
                BackgroundColor="#2196F3" 
                TextColor="White" />

    </VerticalStackLayout>
</ContentPage>