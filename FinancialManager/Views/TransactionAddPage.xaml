<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Resources"
             x:Class="FinancialManager.Views.TransactionAddPage"
             Title="{DynamicResource ManageTransactionTitle}"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="{DynamicResource AmountLabel}" TextColor="{StaticResource SubtleText}" FontSize="13"/>
            <Grid ColumnDefinitions="*, 96" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                    <Entry Text="{Binding Amount}"
                           Keyboard="Numeric"
                           Placeholder="{DynamicResource PlaceholderAmount}"
                           TextColor="{StaticResource TextPrimary}"/>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10,0">
                    <Picker ItemsSource="{Binding Currencies}"
                            SelectedItem="{Binding SelectedCurrency}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource MutedText}"
                            HorizontalOptions="Fill"
                            FontSize="16"/>
                </Border>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsRateFieldsVisible}" Spacing="6">
                <Label Text="{DynamicResource ExchangeRateLabel}" TextColor="{StaticResource SubtleText}" FontSize="13"/>
                <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                    <Entry Text="{Binding ExchangeRate}"
                           Keyboard="Numeric"
                           TextColor="{StaticResource TextPrimary}"
                           Placeholder="{DynamicResource PlaceholderExchangeRate}"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{DynamicResource DescriptionLabel}" TextColor="{StaticResource SubtleText}" FontSize="13"/>
                <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                    <Entry Text="{Binding Description}" Placeholder="{DynamicResource PlaceholderDescription}" MaxLength="250" TextColor="{StaticResource TextPrimary}"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{DynamicResource CategoryLabel}" TextColor="{StaticResource SubtleText}" FontSize="13" FontAttributes="Bold"/>
                <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"
                            ItemDisplayBinding="{Binding LocalizedName}"
                            Title="{DynamicResource SelectCategory}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource MutedText}"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{DynamicResource TypeLabel}" TextColor="{StaticResource SubtleText}" FontSize="13" FontAttributes="Bold"/>
                <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                    <Picker ItemsSource="{Binding TransactionTypes}"
                            SelectedItem="{Binding SelectedType}"
                            ItemDisplayBinding="{Binding LocalizedName}"
                            Title="{DynamicResource SelectType}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource MutedText}"/>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{DynamicResource DateLabel}" TextColor="{StaticResource SubtleText}" FontSize="13"/>
                <Border BackgroundColor="{StaticResource FieldBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,0">
                    <DatePicker Date="{Binding Date}" TextColor="{StaticResource TextPrimary}"/>
                </Border>
            </VerticalStackLayout>

            <Button Text="{DynamicResource Save}"
                    Command="{Binding SaveCommand}"
                    Margin="0,10,0,0"
                    HeightRequest="50"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="{StaticResource OnAccentText}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
