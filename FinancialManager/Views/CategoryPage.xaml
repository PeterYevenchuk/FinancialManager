<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             xmlns:resources="clr-namespace:Resources"
             x:Class="FinancialManager.Views.CategoryPage"
             x:Name="thisPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="{DynamicResource CategoriesTitle}">

    <Grid>
        <CollectionView ItemsSource="{Binding Categories}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Category">
                    <Grid Margin="12,5">
                        <Border Padding="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource CardStroke}"
                                StrokeThickness="1">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectCategoryCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout>
                                <Grid Padding="16">
                                    <HorizontalStackLayout Spacing="15">
                                        <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center"/>
                                        <Label Text="{Binding LocalizedName}" FontSize="18" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource CardStroke}" IsVisible="{Binding IsSelected}"/>

                                <Grid IsVisible="{Binding IsSelected}"
                                      ColumnDefinitions="*, *"
                                      HeightRequest="50"
                                      BackgroundColor="{StaticResource CardBackgroundAlt}">

                                    <Button Grid.Column="0"
                                            Text="{DynamicResource Edit}"
                                            TextColor="{StaticResource TextPrimary}"
                                            BackgroundColor="Transparent"
                                            CornerRadius="0"
                                            Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.EditCategoryCommand}"
                                            CommandParameter="{Binding .}"/>

                                    <Button Grid.Column="1"
                                            Text="{DynamicResource Delete}"
                                            TextColor="{StaticResource Danger}"
                                            BackgroundColor="Transparent"
                                            CornerRadius="0"
                                            Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout HeightRequest="90"/>
            </CollectionView.Footer>
        </CollectionView>

        <Button Text="{DynamicResource Plus}"
                FontSize="24"
                BackgroundColor="{StaticResource AccentGreen}"
                TextColor="{StaticResource OnAccentText}"
                CornerRadius="28"
                HeightRequest="56"
                WidthRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Command="{Binding AddCategoryCommand}"/>
    </Grid>
</ContentPage>
