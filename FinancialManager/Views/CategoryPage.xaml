<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             xmlns:resources="clr-namespace:Resources"
             x:Class="FinancialManager.Views.CategoryPage"
             x:Name="thisPage"
             Title="{DynamicResource CategoriesTitle}">

    <Grid>
        <CollectionView ItemsSource="{Binding Categories}"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Category">
                    <Grid Margin="10,5">
                        <Frame Padding="0" 
                               CornerRadius="10" 
                               HasShadow="False" 
                               BackgroundColor="#1a1a1a"
                               BorderColor="#333">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.SelectCategoryCommand}" 
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout>
                                <Grid Padding="15">
                                    <HorizontalStackLayout Spacing="15">
                                        <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center"/>
                                        <Label Text="{Binding LocalizedName}" FontSize="18" VerticalOptions="Center" TextColor="White"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#333" IsVisible="{Binding IsSelected}"/>

                                <Grid IsVisible="{Binding IsSelected}" 
                                      ColumnDefinitions="*, *" 
                                      HeightRequest="50"
                                      BackgroundColor="#252525">

                                    <Button Grid.Column="0" 
                                            Text="{DynamicResource Edit}" 
                                            TextColor="White"
                                            BackgroundColor="Transparent"
                                            CornerRadius="0"
                                            Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.EditCategoryCommand}"
                                            CommandParameter="{Binding .}"/>

                                    <Button Grid.Column="1" 
                                            Text="{DynamicResource Delete}" 
                                            TextColor="#ff4d4d"
                                            BackgroundColor="Transparent"
                                            CornerRadius="0"
                                            Command="{Binding Source={x:Reference thisPage}, Path=BindingContext.DeleteCategoryCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="{DynamicResource Plus}"
                FontSize="24"
                BackgroundColor="#28a745"
                TextColor="White"
                CornerRadius="25"
                HeightRequest="50"
                WidthRequest="50"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Command="{Binding AddCategoryCommand}"/>
    </Grid>
</ContentPage>