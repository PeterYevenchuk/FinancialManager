<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinancialManager.Views.CategoryPage"
             Title="Categories">
    
    <Grid RowDefinitions="*, Auto">
        <CollectionView ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="10,5" Padding="15">
                        <HorizontalStackLayout Spacing="15">
                            <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Center"/>
                            <Label Text="{Binding LocalizedName}" FontSize="18" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Add Category" Margin="20" Command="{Binding AddCategoryCommand}"/>
    </Grid>
</ContentPage>