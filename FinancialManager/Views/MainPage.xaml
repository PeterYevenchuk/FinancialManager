<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             x:DataType="viewmodels:MainViewModel"
             x:Class="FinancialManager.Views.MainPage"
             BackgroundColor="#121212"
             Title="Дашборд">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 16" Padding="15">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Загальний баланс" TextColor="#D1E4FF" FontSize="13" HorizontalOptions="Center"/>
                    <Label Text="{Binding CurrentBalance}" TextColor="White" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <FlexLayout Wrap="Wrap" 
                        Direction="Row" 
                        JustifyContent="SpaceAround" 
                        AlignItems="Center"
                        AlignContent="Stretch"
                        Margin="0,15,0,0">

                        <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                            <Label Text="📥 Прибутки" TextColor="#A6C8FF" FontSize="11" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalIncome}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                            <Label Text="📤 Витрати" TextColor="#FFA6A6" FontSize="11" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalExpenses}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                            <Label Text="🐷 Заощадження" TextColor="#FFD1A6" FontSize="11" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalSavings}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                            <Label Text="🔄 Інше" TextColor="AntiqueWhite" FontSize="11" HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalOthers}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </FlexLayout>

                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Від:" FontSize="14" TextColor="#aaa" VerticalOptions="Center"/>
                    <DatePicker Date="{Binding StartDate}" Format="dd.MM.yyyy" TextColor="White" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="До:" FontSize="14" TextColor="#aaa" VerticalOptions="Center"/>
                    <DatePicker Date="{Binding EndDate}" Format="dd.MM.yyyy" TextColor="White" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Text="Тип транзакції" FontAttributes="Bold" FontSize="14" TextColor="White"/>

                <FlexLayout BindableLayout.ItemsSource="{Binding TransactionTypes}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Center"
                            AlignContent="Start">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionType">
                            <Border WidthRequest="50" 
                                    HeightRequest="50" 
                                    StrokeShape="RoundRectangle 25" 
                                    BackgroundColor="Transparent"
                                    Stroke="#333"
                                    StrokeThickness="1.5"
                                    Margin="0,0,10,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectTypeCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#28a745" />
                                        <Setter Property="Stroke" Value="#28a745" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 12" 
                    Padding="15" 
                    HeightRequest="180" 
                    BackgroundColor="#1a1a1a" 
                    Stroke="#333">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="📊 Тут буде твій графік" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                    <Label Text="(Згруповано за категоріями)" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Транзакції за період" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                    <Button Grid.Column="1" Text="Скинути" FontSize="12" Command="{Binding ClearFiltersCommand}" BackgroundColor="Transparent" TextColor="#2196F3" Padding="0"/>
                </Grid>

                <CollectionView ItemsSource="{Binding FilteredTransactions}" HeightRequest="300">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <Grid Margin="0,5">
                                <Frame Padding="0" CornerRadius="10" HasShadow="False" BackgroundColor="#1a1a1a" BorderColor="#333">
                                    <Grid Padding="15" ColumnDefinitions="*, Auto">

                                        <VerticalStackLayout Spacing="4">
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding Category.Icon}" FontSize="18"/>
                                                <Label Text="{Binding Category.LocalizedName}" FontSize="16" TextColor="White" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="10" Margin="28,0,0,0">
                                                <Label Text="{Binding TransactionType.Icon}" FontSize="14" VerticalOptions="Center"/>
                                                <Label Text="{Binding TransactionType.LocalizedName}" FontSize="14" TextColor="#bbb"/>
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="#888" Margin="28,0,0,0"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1" 
                                               Text="{Binding AmountDisplay}" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               VerticalOptions="Center"
                                               TextColor="White"/>
                                    </Grid>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>