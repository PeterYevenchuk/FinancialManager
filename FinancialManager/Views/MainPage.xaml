<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="viewmodels:MainViewModel"
             x:Class="FinancialManager.Views.MainPage"
             BackgroundColor="#121212"
             Title="{DynamicResource DashboardTitle}">
    <Grid>
        <CollectionView ItemsSource="{Binding FilteredTransactions}" 
                        SelectionMode="None"
                        RemainingItemsThreshold="3"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreTransactionsCommand}"
                        ItemsUpdatingScrollMode="KeepScrollOffset">

            <CollectionView.Header>
                <VerticalStackLayout Padding="16" Spacing="20">

                    <Button Text="{DynamicResource ExportButton}"
                        Command="{Binding ExportDataCommand}"
                        IsVisible="{Binding IsExportFeatureEnabled}"
                        BackgroundColor="#1e293b"
                        TextColor="#38bdf8"
                        BorderColor="#334155"
                        BorderWidth="1"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="14,0"
                        HorizontalOptions="End" />

                    <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="15">
                        <Border.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnDashboardPanUpdated" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">

                            <Grid ColumnDefinitions="Auto, *, Auto" HorizontalOptions="FillAndExpand" Margin="0,0,0,10">
                                <Button Grid.Column="0" 
                                        Text="‹" 
                                        FontSize="26" 
                                        TextColor="White" 
                                        BackgroundColor="Transparent" 
                                        Command="{Binding PreviousMonthCommand}"
                                        Padding="0" 
                                        WidthRequest="36" 
                                        HeightRequest="36"
                                        VerticalOptions="Center"/>

                                <Label Grid.Column="1" 
                                       Text="{Binding SelectedMonthDisplay}" 
                                       TextColor="White" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>

                                <Button Grid.Column="2" 
                                        Text="›" 
                                        FontSize="26" 
                                        TextColor="White" 
                                        BackgroundColor="Transparent" 
                                        Command="{Binding NextMonthCommand}"
                                        IsEnabled="{Binding CanGoNextMonth}"
                                        Padding="0" 
                                        WidthRequest="36" 
                                        HeightRequest="36"
                                        VerticalOptions="Center">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding CanGoNextMonth}" Value="False">
                                            <Setter Property="Opacity" Value="0.25" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding CanGoNextMonth}" Value="True">
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,0,0,5">
                                <Label Text="{DynamicResource ReportCurrencyLabel}" TextColor="#D1E4FF" FontSize="12" VerticalOptions="Center"/>
                                <Border BackgroundColor="#33FFFFFF" Stroke="#55FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,0" VerticalOptions="Center">
                                    <Picker ItemsSource="{Binding AvailableDisplayCurrencies}"
                                            SelectedItem="{Binding DisplayCurrency}"
                                            IsEnabled="{Binding IsCurrencySelectionEnabled}"
                                            TextColor="White"
                                            TitleColor="White"
                                            FontSize="13"
                                            HeightRequest="34"
                                            WidthRequest="70"
                                            VerticalOptions="Center"/>
                                </Border>
                            </HorizontalStackLayout>

                            <Label Text="{DynamicResource TotalBalanceLabel}" TextColor="#D1E4FF" FontSize="13" HorizontalOptions="Center"/>
                            <Label Text="{Binding CurrentBalance}" TextColor="White" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center"/>

                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceAround" AlignItems="Center" AlignContent="Stretch" Margin="0,15,0,0">
                                <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                                    <Label Text="{DynamicResource IncomeLabel}" TextColor="#A6C8FF" FontSize="11" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalIncome}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                                    <Label Text="{DynamicResource ExpenseLabel}" TextColor="#FFA6A6" FontSize="11" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalExpenses}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                                    <Label Text="{DynamicResource SavingsLabel}" TextColor="#FFD1A6" FontSize="11" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalSavings}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Margin="10,5" HorizontalOptions="Center">
                                    <Label Text="{DynamicResource OthersLabel}" TextColor="AntiqueWhite" FontSize="11" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalOthers}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" VerticalOptions="Center">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="{DynamicResource FromLabel}" FontSize="14" TextColor="#aaa" VerticalOptions="Center"/>
                            <DatePicker Date="{Binding StartDate}" MaximumDate="{Binding EndDate}" Format="dd.MM.yyyy" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="{DynamicResource ToLabel}" FontSize="14" TextColor="#aaa" VerticalOptions="Center"/>
                            <DatePicker Date="{Binding EndDate}" MinimumDate="{Binding StartDate}" Format="dd.MM.yyyy" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="{DynamicResource TransactionTypeHeader}" FontAttributes="Bold" FontSize="14" TextColor="White" VerticalOptions="Center"/>
                            <Button Grid.Column="1"
                                    Text="{DynamicResource Reset}"
                                    FontSize="12"
                                    Command="{Binding ClearFiltersCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Accent}"
                                    BorderColor="{StaticResource Accent}"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    Padding="16,4"
                                    MinimumHeightRequest="0"
                                    HeightRequest="34"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <FlexLayout BindableLayout.ItemsSource="{Binding TransactionTypes}" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center" AlignContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionType">
                                    <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="Transparent" Stroke="#333" StrokeThickness="1.5" Margin="0,0,10,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectTypeCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#28a745" />
                                                <Setter Property="Stroke" Value="#28a745" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Icon}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1a1a1a" Stroke="#333">
                        <Grid>
                            <FlexLayout Direction="Row" 
                                        Wrap="Wrap" 
                                        JustifyContent="SpaceAround" 
                                        AlignItems="Center" 
                                        AlignContent="Center"
                                        IsVisible="{Binding HasChartData}">

                                <microcharts:ChartView Chart="{Binding CategoryChart}" 
                                                       FlexLayout.Basis="160" 
                                                       FlexLayout.Shrink="0" 
                                                       HeightRequest="160" 
                                                       WidthRequest="160" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center" 
                                                       Margin="5"/>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ChartLegendItems}" 
                                                     FlexLayout.Grow="1" 
                                                     FlexLayout.Basis="260" 
                                                     FlexLayout.Shrink="1" 
                                                     Spacing="12" 
                                                     VerticalOptions="Center" 
                                                     Margin="5">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChartLegendItem">
                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectCategoryCommand}" CommandParameter="{Binding .}"/>
                                                </Grid.GestureRecognizers>
                                                <BoxView Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="2" BackgroundColor="{Binding ColorHex}" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding Icon}" FontSize="13" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding Label}" FontSize="13" TextColor="White" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                                <Label Grid.Column="3" Text="{Binding ValueLabel}" FontSize="12" TextColor="#aaa" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </FlexLayout>

                            <Label Text="{DynamicResource NoDataForPeriod}" 
                                   TextColor="#777" 
                                   FontSize="14" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" 
                                   Padding="20">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasChartData}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasChartData}" Value="False">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding IsCategoryFilterActive}" 
                            BackgroundColor="#222" 
                            Stroke="#2196F3" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 8" 
                            Padding="12,4" 
                            Margin="0,5,0,0">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">

                            <HorizontalStackLayout BindingContext="{Binding SelectedCategory}"
                                                   x:DataType="models:ChartLegendItem"
                                                   Spacing="8"
                                                   VerticalOptions="Center">

                                <Label Text="{Binding Icon}" VerticalOptions="Center" />
                                <Label Text="{Binding Label}" VerticalOptions="Center" />

                            </HorizontalStackLayout>

                            <Button Grid.Column="1" 
                                    Text="✕" 
                                    TextColor="#ff4d4d" 
                                    FontAttributes="Bold" 
                                    BackgroundColor="Transparent" 
                                    Command="{Binding ClearCategoryFilterCommand}" 
                                    WidthRequest="30" 
                                    HeightRequest="30" 
                                    Padding="0"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,10,0,0">
                        <Label Grid.Column="0" 
                               Text="{DynamicResource TransactionsPeriodLabel}" 
                               FontAttributes="Bold" 
                               FontSize="16" 
                               TextColor="White" 
                               VerticalOptions="Center"/>

                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource FieldBackground}"
                                Stroke="{StaticResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,0"
                                HorizontalOptions="End"
                                VerticalOptions="Center">
                            <Picker ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SelectedSortOption}"
                                    TextColor="{StaticResource Accent}"
                                    TitleColor="{StaticResource MutedText}"
                                    FontSize="13"
                                    HeightRequest="38"
                                    WidthRequest="180"
                                    VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transaction">
                    <Border Margin="16, 4" Padding="0" StrokeShape="RoundRectangle 10" BackgroundColor="#1a1a1a" Stroke="#333" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SelectTransactionCommand}" CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <VerticalStackLayout>
                            <Grid Padding="15" ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Category.Icon}" FontSize="18"/>
                                        <Label Text="{Binding Category.LocalizedName}" FontSize="16" TextColor="White" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" Margin="28,0,0,0">
                                        <Label Text="{Binding TransactionType.Icon}" FontSize="14" VerticalOptions="Center"/>
                                        <Label Text="{Binding TransactionType.LocalizedName}" FontSize="14" TextColor="#bbb"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding Description}" FontSize="14" TextColor="#bbb" LineBreakMode="WordWrap" Margin="28,4,15,0"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                    <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="#888" HorizontalOptions="End"/>
                                    <Label Text="{Binding AmountDisplay}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="End"/>
                                    <Label Text="{Binding ExchangeRateToUahDisplay}" FontSize="12" TextColor="#aaaaaa" IsVisible="{Binding ShowExchangeRate}" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding IsSelected}" BackgroundColor="#252525" Padding="15,12">
                            <Grid ColumnDefinitions="*, *">
                                <Button Grid.Column="0" Text="{DynamicResource Edit}" TextColor="White" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EditTransactionCommand}" CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1" Text="{DynamicResource Delete}" TextColor="#ff4d4d" BackgroundColor="Transparent" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=DeleteTransactionCommand}" CommandParameter="{Binding .}"/>
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout HeightRequest="90"/>
            </CollectionView.Footer>
        </CollectionView>

        <Button Text="+" 
                FontSize="28" 
                TextColor="White" 
                BackgroundColor="#28a745" 
                CornerRadius="28" 
                WidthRequest="56" 
                HeightRequest="56" 
                HorizontalOptions="End" 
                VerticalOptions="End" 
                Margin="0,0,20,20" 
                Command="{Binding AddTransactionCommand}"/>
    </Grid>
</ContentPage>