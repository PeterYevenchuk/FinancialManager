<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             x:Class="FinancialManager.Views.BackupPage"
             x:DataType="vm:BackupViewModel"
             Title="{DynamicResource BackupTitle}"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <Grid RowDefinitions="*, Auto" Padding="20">

            <VerticalStackLayout Grid.Row="0" Spacing="20" VerticalOptions="Start">

                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="🛡️" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="{DynamicResource Backup_SecurityHeading}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="{DynamicResource Backup_SecurityDesc}"
                               TextColor="{StaticResource MutedText}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="10">
                        <Label Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="📤" FontSize="32" VerticalOptions="Center"/>

                        <Label Grid.Column="1" Grid.Row="0" Text="{DynamicResource Backup_ExportTitle}" TextColor="{StaticResource TextPrimary}" FontSize="16" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Grid.Row="1" Text="{DynamicResource Backup_ExportDesc}" TextColor="{StaticResource SubtleText}" FontSize="13"/>

                        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                Text="{DynamicResource Backup_ExportButton}"
                                Command="{Binding ExportBackupCommand}"
                                BackgroundColor="{StaticResource AccentGreen}"
                                TextColor="{StaticResource OnAccentText}"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="10"
                                Margin="0,5,0,0"/>
                    </Grid>
                </Border>

                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="10">
                        <Label Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="📥" FontSize="32" VerticalOptions="Center"/>

                        <Label Grid.Column="1" Grid.Row="0" Text="{DynamicResource Backup_ImportTitle}" TextColor="{StaticResource TextPrimary}" FontSize="16" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Grid.Row="1" Text="{DynamicResource Backup_ImportDesc}" TextColor="{StaticResource SubtleText}" FontSize="13"/>

                        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                Text="{DynamicResource Backup_ImportButton}"
                                Command="{Binding ImportBackupCommand}"
                                BackgroundColor="{StaticResource AccentBlue}"
                                TextColor="{StaticResource OnAccentText}"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="10"
                                Margin="0,5,0,0"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="End" Margin="0,20,0,0">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" HeightRequest="40" WidthRequest="40"/>
                <Label Text="{DynamicResource Backup_Processing}" IsVisible="{Binding IsBusy}" TextColor="{StaticResource Accent}" FontSize="12" Margin="0,5,0,0" HorizontalOptions="Center"/>
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
