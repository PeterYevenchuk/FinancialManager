<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             x:DataType="vm:FeaturesViewModel"
             x:Class="FinancialManager.Views.FeaturesPage"
             BackgroundColor="#121212"
             Title="{DynamicResource FeaturesTitle}">

    <CollectionView ItemsSource="{Binding Features}" 
                    SelectionMode="None" 
                    Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Feature">
                <Border Margin="0,0,0,12" 
                        Padding="16" 
                        StrokeShape="RoundRectangle 12" 
                        BackgroundColor="#1a1a1a" 
                        Stroke="#333" 
                        StrokeThickness="1">

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">

                        <Label Grid.Row="0" 
                               Grid.Column="0" 
                               Text="{Binding LocalizedName}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               VerticalOptions="Center"/>

                        <Label Grid.Row="1" 
                               Grid.Column="0" 
                               Text="{Binding LocalizedDescription}" 
                               FontSize="12" 
                               TextColor="#888" 
                               VerticalOptions="Center"/>

                        <Switch Grid.Row="0" 
                                Grid.RowSpan="2" 
                                Grid.Column="1"
                                IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                OnColor="#28a745"
                                ThumbColor="White"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>