<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinancialManager.ViewModels"
             xmlns:models="clr-namespace:FinancialManager.Models"
             x:DataType="vm:FeaturesViewModel"
             x:Class="FinancialManager.Views.FeaturesPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="{DynamicResource FeaturesTitle}">

    <CollectionView ItemsSource="{Binding Features}"
                    SelectionMode="None"
                    Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Feature">
                <Border Margin="0,0,0,12"
                        Padding="16"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource CardStroke}"
                        StrokeThickness="1">

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" RowDefinitions="Auto, Auto" RowSpacing="4">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding LocalizedName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="{Binding LocalizedDescription}"
                               FontSize="12"
                               TextColor="{StaticResource MutedText}"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center"/>

                        <Switch Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                OnColor="{StaticResource AccentGreen}"
                                ThumbColor="White"
                                VerticalOptions="Center"
                                HorizontalOptions="End"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>